  intervalNumber Int      @default(0) @db.SmallInt
  intervalTime   String   @default("") @db.VarChar(15)
  purchaseBid    Decimal  @default(0) @db.Decimal(18, 4)
  sellBid        Decimal  @default(0) @db.Decimal(18, 4)
  mcv            Decimal  @default(0) @db.Decimal(18, 4)
  fsv            Decimal  @default(0) @db.Decimal(18, 4)
  mcp            Decimal  @default(0) @db.Decimal(18, 4)
  createdAt      DateTime @default(now())
